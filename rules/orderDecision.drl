package com.myspace.orders_rules;

import java.time.LocalDate;
import java.time.Period;
import java.util.Map;

global java.util.Map orderDecision;

rule "Allow valid adult order"
when
    order : Map(
        this["birthDate"] != null,
        this["evaluationAtUtc"] != null,
        this["quantity"] != null
    )
    eval(
        ((Number) order.get("quantity")).intValue() > 0
        && Period.between(
            LocalDate.parse(order.get("birthDate").toString().substring(0, 10)),
            LocalDate.parse(order.get("evaluationAtUtc").toString().substring(0, 10))
        ).getYears() >= 18
    )
then
    orderDecision.put("allowed", true);
    orderDecision.put("reason", "Customer is at least 18 years old and the quantity is valid.");
end

rule "Deny invalid or underage order"
when
    order : Map()
    eval(
        order.get("birthDate") == null
        || order.get("evaluationAtUtc") == null
        || order.get("quantity") == null
        || !(order.get("quantity") instanceof Number)
        || ((Number) order.get("quantity")).intValue() <= 0
        || Period.between(
            LocalDate.parse(order.get("birthDate").toString().substring(0, 10)),
            LocalDate.parse(order.get("evaluationAtUtc").toString().substring(0, 10))
        ).getYears() < 18
    )
then
    orderDecision.put("allowed", false);
    orderDecision.put("reason", "The customer must be at least 18 years old and quantity must be positive.");
end
